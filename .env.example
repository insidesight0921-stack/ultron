# ===== AI Agent .env.example =====
# 이 파일은 키 이름만 보관. 실제 값은 .env에 (gitignore 처리됨).
# 사용 전: cp .env.example .env  → 값 채우기

# ----- 텔레그램 봇 -----
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=

# ----- KIS API (한국투자증권 자동매매, 5단계~) -----
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
# 실전 / 모의 구분 (real | mock)
KIS_ENV=mock

# ----- 외부 LLM API (4단계~) -----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ----- 데이터 API (4~5단계~) -----
DART_API_KEY=
ECOS_API_KEY=
KOSIS_API_KEY=
FRED_API_KEY=

# ----- Ollama (로컬 LLM) -----
# 본인 Tailscale IP로만 바인딩 권장 (보안)
OLLAMA_HOST=127.0.0.1:11434

# ----- 경로 설정 -----
VAULT_PATH=
PROJECT_PATH=

# ----- 모의투자 사이트 -----
MOCK_TRADING_PORT=8080
MOCK_TRADING_DB=./data/paper.db
